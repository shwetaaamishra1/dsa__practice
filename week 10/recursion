#include<iostream>
using namespace std;

void print(int num, int N)
{
    if(num==N)
    {
        cout<<num<<endl;
        return;
    }
    cout<<num<<endl;
    print(num+1,N);
}

int main(){
    //print number from 1 to N
    int N;
    cin>>N;
    print(1,N);
}
