#include<iostream>
using namespace std;

int fib(int n){
   // if(n<=1)
   if(n==0)
   {
    return 1;
   }
    return fib(n-1)+fib(n-2);
}

int main()
{
    int n;
    cout<<"enter the value of n";
    cin>>n;

    fib(n);
}

